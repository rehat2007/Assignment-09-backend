# Copy to .env and fill in the real values.
PORT=4000

# MongoDB (Atlas or local)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=fixmate
# Only needed on machines whose resolver refuses mongodb+srv SRV lookups.
# MONGODB_DNS_SERVERS=1.1.1.1

# Better Auth: must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Optional separate signing secret for API JWTs. Falls back to BETTER_AUTH_SECRET.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# The backend origin (used for cookies, OAuth callbacks, and avatar URLs).
BETTER_AUTH_URL=http://localhost:4000
# The Next.js origin allowed by CORS and Better Auth trustedOrigins.
FRONTEND_URL=https://assignment-09-frontend-two.vercel.app

# Optional Google OAuth. Callback URL in Google Console:
#   http://localhost:4000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Used by `npm run auth:admin`.
ADMIN_EMAIL=admin@fixmate.dev
ADMIN_PASSWORD=
ADMIN_NAME=FixMate Admin

# Password for every non-admin demo account created by `npm run seed`.
# Existing accounts keep their current password when the seed is re-run.
SEED_PASSWORD=FixMateDemo123!

# Stripe test mode. Leave blank to run the rest of the app without payments.
# Local webhook testing:
#   stripe listen --forward-to localhost:4000/api/v1/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Uploads. `local` writes to ./data/uploads and serves files from the API.
# Use `imgbb` for Assignment 9, or `s3` for AWS S3 / R2 / MinIO.
UPLOAD_DRIVER=local
# Required when UPLOAD_DRIVER=imgbb.
IMGBB_API_KEY=
# Required when UPLOAD_DRIVER=s3. R2 uses region `auto`.
S3_BUCKET=
S3_REGION=
# Leave both blank to use the default AWS credential chain (IAM role, etc.).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional for R2/MinIO, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Optional public/CDN base for the stored objects. When blank, the AWS virtual-hosted
# URL (or S3_ENDPOINT/bucket) is used.
S3_PUBLIC_URL=
# Set to true for MinIO and other path-style providers.
S3_FORCE_PATH_STYLE=false
